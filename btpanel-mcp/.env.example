# 宝塔面板 MCP Server 配置模板（严禁填写真实凭据，仅作占位示例）
# 用法：复制为 .env 后按需填写，或直接在进程环境中设置同名变量。
# 注意：本仓库不读取 .env 文件，配置一律来自环境变量（含 opensquilla 等
#       宿主进程通过 env 字段注入的变量）。

# 面板地址（含安全路径），例如 http://127.0.0.1:8888/C70AGNQm
# 内部会自动剥离安全路径得到 API 基址，并用于首页 token 探测。
BAOTA_BASE_URL=http://127.0.0.1:8888/你的安全路径

# 会话 cookie JSON 文件（从浏览器开发者工具复制，格式见 README.md）。
# 与 BAOTA_REQUEST_TOKEN 二选一；二者都设置时优先使用 REQUEST_TOKEN。
BAOTA_SESSION_FILE=./session.json

# 面板 token（Windows 面板风格，请求头 x-http-token 校验）。
# BAOTA_REQUEST_TOKEN=

# 写操作（建站/建库/建FTP/写文件/上传/删除/exec）默认只模拟，true=只打印不执行
BAOTA_DRY_RUN=true

# 高危 exec 工具需要 true 且命令在只读白名单内才会真正执行
BAOTA_CONFIRM_EXEC=true
