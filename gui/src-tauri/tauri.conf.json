{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Marguerite",
    "version":  "0.2.13",
    "identifier":  "com.marguerite.workbench",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "echo front-end is built externally by scripts/package_app.cmd",
                  "frontendDist":  "webui/dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Marguerite",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  960,
                                    "minHeight":  640,
                                    "center":  true,
                                    "decorations":  false,
                                    "url":  "http://localhost:18790/control/"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "msi",
                                   "nsis"
                               ],
                   "resources":  [
                                     "webui/dist",
                                     "skills",
                                     "resources",
                                     "resources/modes",
                                     "resources/pyengine",
                                     "resources/plugins",
                                     "resources/btpanel-mcp",
                                     "resources/docs",
                                     "resources/scripts"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "offlineInstaller",
                                                              "silent":  true
                                                          },
                                    "wix":  {
                                                "language":  {
                                                                 "en-US":  {
                                                                               "localePath":  "wix/locale/en-US.wxl"
                                                                           }
                                                             },
                                                "fragmentPaths": [
                                                    "wix/fragments/shortcuts.wxs"
                                                ]
                                            }
                               }
               }
}

