{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Marguerite",
    "version":  "0.2.19",
    "identifier":  "com.marguerite.workbench",
    "build":  {
                  "beforeDevCommand":  "",
                  "devUrl":  "http://localhost:18790/control/",
                  "beforeBuildCommand":  "echo front-end is prebuilt into webui/dist by scripts/package_app.cmd",
                  "frontendDist":  "webui/dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Marguerite",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  960,
                                    "minHeight":  640,
                                    "center":  true,
                                    "decorations":  false,
                                    "url":  "splash.html"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob:; font-src \u0027self\u0027 data:; media-src \u0027self\u0027 data: blob:; connect-src \u0027self\u0027 ipc: http://ipc.localhost ws: wss:; object-src \u0027none\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; worker-src \u0027self\u0027 blob:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  [
                                   "msi",
                                   "nsis"
                               ],
                   "resources":  [
                                     "webui/dist",
                                     "skills",
                                     "resources",
                                     "resources/modes",
                                     "resources/pyengine",
                                     "resources/btpanel-mcp",
                                     "resources/docs",
                                     "resources/scripts"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "offlineInstaller",
                                                              "silent":  true
                                                          },
                                   "wix":  {
                                               "language":  {
                                                                "en-US":  {
                                                                              "localePath":  "wix/locale/en-US.wxl"
                                                                          }
                                                            },
                                               "fragmentPaths":  [
                                                                     "wix/fragments/shortcuts.wxs"
                                                                 ]
                                           }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://github.com/KLJyouth1/Marguerite-Releases/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NzhGMUNFMUI5MjE4ODgKUldTSUdKSWJ6dkY0dFNWOFNaREtpeXFyRCswVTBTOWprUngvcHhiaWExRm1uU1hhY0Jtak5UZmcK",
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}

