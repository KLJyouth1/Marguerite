{
  "identifier": "com.marguerite.workbench",
  "description": "Marguerite CLI Workbench GUI 壳默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ],
  "remote": {
    "urls": ["http://localhost:18790/*", "http://127.0.0.1:18790/*"]
  }
}
