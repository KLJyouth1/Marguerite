# --- generated lockfiles: keep them, but collapse them in diffs and language stats ---
Cargo.lock            -diff linguist-generated
package-lock.json     -diff linguist-generated
webui/package-lock.json -diff linguist-generated
gui/package-lock.json   -diff linguist-generated
pnpm-lock.yaml        -diff linguist-generated

# --- vendored / frozen third-party snapshots ---
third_party/** -diff linguist-vendored
