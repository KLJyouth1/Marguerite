{
  "name": "marguerite-webui",
  "private": true,
  "version": "0.2.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:artifact",
    "build:artifact": "vite build && node scripts/normalize-dist.mjs && node scripts/check-theme-bundle.mjs && node scripts/check-runtime-bundle.mjs && node scripts/verify-dist.mjs --write",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:release-dist": "node scripts/verify-dist.mjs --forbid-personal-bgm",
    "preview": "vite preview",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-chat-security.mjs && node scripts/check-webui-colors.mjs && node scripts/check-webui-motion.mjs && node scripts/check-webui-radius.mjs && node scripts/check-theme-contract.mjs && node scripts/check-theme-scope.mjs && node scripts/check-cross-surface-tokens.mjs && node scripts/check-i18n.mjs && node scripts/check-channel-catalog-i18n.mjs && node scripts/check-rpc-contract.mjs && node scripts/check-index-injection-contract.mjs && node scripts/check-splash-media.mjs",
    "check:readme-locales": "node scripts/check-readme-locales.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "deps:lockfile-sync": "npm ci --dry-run",
    "typecheck": "npm run check:architecture && vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/dompurify": "^3.0.5",
    "@types/three": "^0.185.4",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "0.19.0",
    "marked": "^18.0.4",
    "pinia": "^2.1.7",
    "three": "^0.185.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "axe-core": "^4.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.4.5",
    "vite": "8.3.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.9"
  }
}
