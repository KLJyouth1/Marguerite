<Window x:Class="MargueriteDownloader.DownloaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Marguerite Downloader"
        Width="1040"
        Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootCanvas" Width="1040" Height="640">
        <Image x:Name="PosterSurface"
               Source="Assets/poster-welcome.jpg"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <MediaElement x:Name="VideoSurface"
                      Stretch="UniformToFill"
                      Opacity="0"
                      IsMuted="True"
                      Volume="0.3"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      MediaOpened="VideoSurface_MediaOpened"
                      MediaEnded="VideoSurface_MediaEnded"
                      MediaFailed="VideoSurface_MediaFailed" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0.85,0">
                    <GradientStop Color="#F205070C" Offset="0" />
                    <GradientStop Color="#D905070C" Offset="0.42" />
                    <GradientStop Color="#4D05070C" Offset="0.72" />
                    <GradientStop Color="#0005070C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A605070C" Offset="0" />
                    <GradientStop Color="#0005070C" Offset="0.34" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="52,30,44,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Height="42" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/brand-mark.png"
                           Width="28"
                           Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#66A9D3F2" Opacity="0.75" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="Marguerite"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="20"
                               Foreground="{StaticResource IvoryBrush}"
                               VerticalAlignment="Center"
                               Margin="11,0,0,0" />
                    <TextBlock Text="DOWNLOADER"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IceBrush}"
                               VerticalAlignment="Center"
                               Margin="12,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SoundButton" Style="{StaticResource IconButton}" Click="Sound_Click" ToolTip="开启声音">
                        <TextBlock x:Name="SoundGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74F;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化" Margin="2,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭" Margin="2,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <StackPanel Width="460" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource EyebrowText}"
                               x:Name="KickerText"
                               Text="MARGUERITE · 0.2.17" />

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource DisplayTitle}"
                               Margin="0,12,0,0"
                               Text="正在下载" />

                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource BodyText}"
                               Margin="0,10,0,0"
                               Text="正在连接发布仓库…" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock x:Name="PercentText"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="46"
                                   Foreground="{StaticResource IvoryBrush}"
                                   Text="0" />
                        <TextBlock Text="%"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="3,0,0,8" />
                        <TextBlock x:Name="StageChip"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource IceBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="16,0,0,12"
                                   Text="准备中" />
                    </StackPanel>

                    <ProgressBar x:Name="ProgressBar"
                                 Style="{StaticResource IceProgress}"
                                 Width="430"
                                 HorizontalAlignment="Left"
                                 Margin="0,4,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />

                    <TextBlock x:Name="MetaText"
                               Style="{StaticResource FineText}"
                               Margin="0,10,0,0"
                               Text="—" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="&#x25CF;"
                                   FontSize="7"
                                   Foreground="{StaticResource IceBrush}"
                                   VerticalAlignment="Center"
                                   Opacity="0.9" />
                        <TextBlock x:Name="FilmNoteText"
                                   Style="{StaticResource FineText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="片头播完一整遍才会打开安装界面" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="RetryButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="重试"
                                Visibility="Collapsed"
                                Click="Retry_Click" />
                        <Button x:Name="CancelButton"
                                Style="{StaticResource LinkButton}"
                                Content="取消"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0"
                                Click="Cancel_Click" />
                        <Button x:Name="FolderButton"
                                Style="{StaticResource LinkButton}"
                                Content="打开下载位置"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0"
                                Visibility="Collapsed"
                                Click="Folder_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="FooterText"
                           Style="{StaticResource FineText}"
                           VerticalAlignment="Center"
                           Text="PROMO FILM · 90s · LOOPING" />
                <TextBlock x:Name="DemoBadge"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="11"
                           Foreground="{StaticResource WarnBrush}"
                           Visibility="Collapsed"
                           Text="演示模式 · 不会打开安装程序" />
            </Grid>
        </Grid>

        <Border BorderBrush="#1FFFFFFF" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
