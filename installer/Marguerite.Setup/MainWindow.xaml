<Window x:Class="MargueriteSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Marguerite Setup"
        Width="1200"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootCanvas" Width="1200" Height="720">
        <!-- ============================================================
             Background film
             ============================================================ -->
        <Image x:Name="PosterSurface"
               Source="/Assets/poster-welcome.jpg"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <MediaElement x:Name="VideoSurface"
                      Stretch="UniformToFill"
                      Opacity="0"
                      IsMuted="True"
                      Volume="0.35"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      ScrubbingEnabled="True"
                      MediaOpened="VideoSurface_MediaOpened"
                      MediaFailed="VideoSurface_MediaFailed"
                      MediaEnded="VideoSurface_MediaEnded" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F205070C" Offset="0" />
                    <GradientStop Color="#E605070C" Offset="0.36" />
                    <GradientStop Color="#5505070C" Offset="0.66" />
                    <GradientStop Color="#0005070C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#B305070C" Offset="0" />
                    <GradientStop Color="#0005070C" Offset="0.45" />
                    <GradientStop Color="#3305070C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="SceneFade" Fill="#05070C" Opacity="0" IsHitTestVisible="False" />

        <!-- ============================================================
             Interface
             ============================================================ -->
        <Grid Margin="64,34,56,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/brand-mark.png"
                           Width="30"
                           Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#66A9D3F2" Opacity="0.8" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="Marguerite"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               Foreground="{StaticResource IvoryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Text="SETUP"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IceBrush}"
                               VerticalAlignment="Center"
                               Margin="14,2,0,0" />
                    <TextBlock Text="0.2.17"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center"
                               Margin="8,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SoundButton"
                            Style="{StaticResource IconButton}"
                            Click="Sound_Click"
                            ToolTip="Mute">
                        <TextBlock x:Name="SoundGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE74F;" />
                    </Button>
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource IconButton}"
                            Click="Minimize_Click"
                            ToolTip="Minimize"
                            Margin="2,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource IconButton}"
                            Click="Close_Click"
                            ToolTip="Close"
                            Margin="2,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Step content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="490" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,10">

                    <!-- 01 · Welcome -->
                    <Grid x:Name="StepWelcome" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{Binding L[WelcomeEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[WelcomeTitle]}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Margin="0,16,0,0"
                                       Text="{Binding L[WelcomeBody]}" />

                            <StackPanel Margin="0,26,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="18" Height="1" Background="{StaticResource IceBrush}" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource FeatureText}" Margin="12,0,0,0" Text="{Binding L[Feature1]}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="18" Height="1" Background="{StaticResource IceBrush}" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource FeatureText}" Margin="12,0,0,0" Text="{Binding L[Feature2]}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="1" Background="{StaticResource IceBrush}" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource FeatureText}" Margin="12,0,0,0" Text="{Binding L[Feature3]}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FineText}"
                                       Margin="0,22,0,0"
                                       Text="{Binding L[WelcomeNote]}" />

                            <Button x:Name="WelcomeStartButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,30,0,0"
                                    HorizontalAlignment="Left"
                                    Content="{Binding L[Start]}"
                                    Click="WelcomeStart_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 02 · License -->
                    <Grid x:Name="StepLicense" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{Binding L[LicenseEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[LicenseTitle]}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[LicenseBody]}" />

                            <Border Margin="0,20,0,0"
                                    Height="196"
                                    Background="#14FFFFFF"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.86" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <TextBlock x:Name="LicenseText"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="#C9C4BB"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,18" />
                                </ScrollViewer>
                            </Border>

                            <CheckBox x:Name="LicenseAgreeToggle"
                                      Style="{StaticResource SwitchCheckBox}"
                                      Margin="0,18,0,0"
                                      Content="{Binding L[LicenseAgree]}"
                                      Checked="LicenseAgree_Changed"
                                      Unchecked="LicenseAgree_Changed" />

                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Button x:Name="LicenseContinueButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{Binding L[Continue]}"
                                        IsEnabled="False"
                                        Click="LicenseContinue_Click" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{Binding L[Back]}"
                                        Margin="12,0,0,0"
                                        Click="LicenseBack_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 03 · Options -->
                    <Grid x:Name="StepOptions" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{Binding L[OptionsEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[OptionsTitle]}" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[OptionsBody]}" />

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Margin="0,22,0,8"
                                       Text="{Binding L[InstallPathLabel]}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox"
                                         Style="{StaticResource PathBox}"
                                         TextChanged="InstallPath_TextChanged" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Height="42"
                                        Padding="14,0"
                                        Margin="8,0,0,0"
                                        Content="{Binding L[Browse]}"
                                        Click="Browse_Click" />
                            </Grid>

                            <TextBlock x:Name="PathErrorText"
                                       Style="{StaticResource FineText}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0" />

                            <TextBlock x:Name="ExistingInstallNote"
                                       Style="{StaticResource FineText}"
                                       Foreground="{StaticResource WarnBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0"
                                       Text="{Binding L[ExistingInstall]}" />

                            <TextBlock x:Name="OtherInstallNote"
                                       Style="{StaticResource FineText}"
                                       Foreground="{StaticResource WarnBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="ShortcutsToggle"
                                      Style="{StaticResource SwitchCheckBox}"
                                      Margin="0,18,0,0"
                                      IsChecked="True"
                                      Content="{Binding L[ShortcutsLabel]}" />

                            <CheckBox x:Name="LaunchToggle"
                                      Style="{StaticResource SwitchCheckBox}"
                                      Margin="0,12,0,0"
                                      IsChecked="True"
                                      Content="{Binding L[LaunchLabel]}" />

                            <Border Margin="0,20,0,0"
                                    Background="#12FFFFFF"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="PayloadDot"
                                             Width="6"
                                             Height="6"
                                             Fill="{StaticResource IceBrush}"
                                             VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding L[PayloadLabel]}" />
                                        <TextBlock x:Name="PayloadNameText"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="12"
                                                   Foreground="#C9C4BB"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="PayloadActionButton"
                                            Grid.Column="2"
                                            Style="{StaticResource LinkButton}"
                                            Content="{Binding L[ChooseFile]}"
                                            VerticalAlignment="Center"
                                            Click="PayloadAction_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource FineText}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[OptionsNote]}" />

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button x:Name="InstallButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{Binding L[Install]}"
                                        Click="Install_Click" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{Binding L[Back]}"
                                        Margin="12,0,0,0"
                                        Click="OptionsBack_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 04 · Installing -->
                    <Grid x:Name="StepInstalling" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource EyebrowText}" Text="{Binding L[InstallingEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[InstallingTitle]}" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <TextBlock x:Name="PercentText"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="58"
                                           Foreground="{StaticResource IvoryBrush}"
                                           Text="0" />
                                <TextBlock Text="%"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,10" />
                            </StackPanel>

                            <ProgressBar x:Name="ProgressBar"
                                         Style="{StaticResource IceProgress}"
                                         Width="440"
                                         HorizontalAlignment="Left"
                                         Margin="0,10,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />

                            <TextBlock x:Name="StageText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,14,0,0"
                                       Foreground="#DCD6CC" />

                            <TextBlock x:Name="ElapsedText"
                                       Style="{StaticResource FineText}"
                                       Margin="0,6,0,0" />

                            <TextBlock Style="{StaticResource FineText}"
                                       Margin="0,18,0,0"
                                       Text="{Binding L[InstallingNote]}" />

                            <Button x:Name="CancelInstallButton"
                                    Style="{StaticResource LinkButton}"
                                    Margin="0,26,0,0"
                                    Content="{Binding L[CancelInstall]}"
                                    Click="CancelInstall_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 05 · Finish -->
                    <Grid x:Name="StepFinish" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <Border Width="54"
                                    Height="54"
                                    CornerRadius="27"
                                    Background="{StaticResource IceBrush}"
                                    HorizontalAlignment="Left"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#66A9D3F2" Opacity="0.7" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="FinishMarkScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="21"
                                           Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Style="{StaticResource EyebrowText}"
                                       Margin="0,22,0,0"
                                       Text="{Binding L[FinishEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[FinishTitle]}" />
                            <TextBlock x:Name="FinishBodyText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource FineText}"
                                       Margin="0,16,0,0"
                                       Text="{Binding L[FinishNote]}" />

                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Button x:Name="LaunchButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{Binding L[LaunchNow]}"
                                        Click="Launch_Click" />
                                <Button x:Name="OpenFolderButton"
                                        Style="{StaticResource GhostButton}"
                                        Content="{Binding L[OpenFolder]}"
                                        Margin="12,0,0,0"
                                        Click="OpenFolder_Click" />
                            </StackPanel>

                            <Button Style="{StaticResource LinkButton}"
                                    Margin="0,18,0,0"
                                    Content="{Binding L[Done]}"
                                    Click="Done_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Interrupted -->
                    <Grid x:Name="StepError" Visibility="Collapsed" Opacity="0">
                        <StackPanel Width="470" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource EyebrowText}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding L[ErrorEyebrow]}" />
                            <TextBlock Style="{StaticResource DisplayTitle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding L[ErrorTitle]}" />
                            <TextBlock x:Name="ErrorBodyText"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,16,0,0"
                                       Foreground="#E6DED3" />
                            <TextBlock x:Name="ErrorLogText"
                                       Style="{StaticResource FineText}"
                                       Margin="0,14,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <Button x:Name="RetryButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{Binding L[Retry]}"
                                        Click="Retry_Click" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{Binding L[Exit]}"
                                        Margin="12,0,0,0"
                                        Click="Exit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StepDot1" Width="26" Height="2" Background="#33FFFFFF" Margin="0,0,6,0" />
                        <Border x:Name="StepDot2" Width="26" Height="2" Background="#33FFFFFF" Margin="0,0,6,0" />
                        <Border x:Name="StepDot3" Width="26" Height="2" Background="#33FFFFFF" Margin="0,0,6,0" />
                        <Border x:Name="StepDot4" Width="26" Height="2" Background="#33FFFFFF" Margin="0,0,6,0" />
                        <Border x:Name="StepDot5" Width="26" Height="2" Background="#33FFFFFF" />
                    </StackPanel>
                    <TextBlock x:Name="StepText"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               Foreground="{StaticResource DimBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="DemoBadge"
                            Visibility="Collapsed"
                            Background="#1AD9A45B"
                            BorderBrush="#55D9A45B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[DemoBadge]}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource WarnBrush}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource LinkButton}" Click="Language_Click">
                        <TextBlock x:Name="LanguageButtonText"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource IceBrush}"
                                   Text="EN" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border BorderBrush="#1FFFFFFF" BorderThickness="1" IsHitTestVisible="False" />

        <!-- ============================================================
             Modal
             ============================================================ -->
        <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#CC03050A">
            <Border Width="460"
                    Background="#F20B101A"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="#B3000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ModalTitle"
                               Style="{StaticResource EyebrowText}"
                               Foreground="{StaticResource IvoryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ModalBody"
                               Style="{StaticResource BodyText}"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="ModalSecondary" Style="{StaticResource GhostButton}" />
                        <Button x:Name="ModalPrimary" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
