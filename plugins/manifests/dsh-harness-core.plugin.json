{
  "name": "dsh-harness-core",
  "version": "0.1.0-rc.7-mgr1",
  "description": "DSH Harness 核心能力二创封装：版本查询、运行时探测、插件 bundle 拓扑加载入口（Marguerite 单一事实源锚点）",
  "author": "marguerite-dsh",
  "capabilities": [
    "dsh.runtime.version",
    "dsh.runtime.ping",
    "dsh.runtime.list_plugins",
    "dsh.bundle.topo_order"
